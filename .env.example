# Copiá este archivo como .env.local y completá con los datos de tu proyecto
# (Supabase → Project Settings → API / API Keys)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Publishable key (sb_publishable_...) o la anon key legacy. Es pública: la seguridad la da RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
